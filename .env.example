# Copy to .env and fill in values. Compose substitutes these into
# docker-compose.yml; the app also reads them directly via pydantic-settings.
#
# IMPORTANT: single-quote any URL containing '&'. Unquoted, `set -a; source .env`
# parses the '&' as a background-job operator and the variable silently stays
# unset — psql then falls back to a local socket and reports
# `role "<your-username>" does not exist`, which always means "empty connection
# string", never "the remote server rejected me".

# --- Database ---------------------------------------------------------------
# Production: one URL from the managed provider. This wins over the discrete
# fields below when set. The app strips the libpq-only query parameters
# (sslmode, channel_binding) that asyncpg rejects and re-applies TLS itself.
# DATABASE_URL='postgresql://user:pass@host/dbname?sslmode=require'

# Local compose path (used when DATABASE_URL is unset):
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=tutorial_db
# When running the app OUTSIDE docker, point it at the pgbouncer port:
# DB_HOST=localhost
# DB_PORT=6432

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Managed Redis usually issues a TLS endpoint; Celery is configured for it
# automatically when the scheme is rediss://.
# REDIS_URL='rediss://default:pass@host:6379/0'

# --- Schema bootstrap -------------------------------------------------------
# true  = create extension + tables on app startup (convenient locally)
# false = run `python cli.py init-db` as an explicit deploy step (production,
#         where concurrent replicas would otherwise race on CREATE TABLE)
BOOTSTRAP_DB_ON_STARTUP=true

# --- Embeddings -------------------------------------------------------------
# local  = sentence-transformers in-process. Needs requirements.txt (torch).
#          This is what the README's hit@5 / MRR numbers were measured with.
# jina /
# openai /
# together = any API speaking the OpenAI embeddings wire format. No torch,
#          ~80 MB RSS instead of ~1.5 GB, which is what makes a free-tier
#          container viable. Vendor is chosen purely by BASE + MODEL below.
# gemini = Google's own (different wire format).
#
# The column is Vector(768), so the model must return 768 dimensions.
# `python cli.py check-embeddings` verifies this before you deploy.
#
# --- Recommended: Jina (768-dim natively, free tier, no card) ---
EMBEDDING_PROVIDER=jina
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.jina.ai/v1
EMBEDDING_API_MODEL=jina-embeddings-v2-base-en
# Only OpenAI's text-embedding-3-* accepts a dimensions override; sending it to
# a model that does not is a 400. Leave false for Jina (already 768).
EMBEDDING_API_SEND_DIMENSIONS=false

# --- Alternative: OpenAI (1536-dim, truncated to 768 via the flag above) ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_MODEL=text-embedding-3-small
# EMBEDDING_API_SEND_DIMENSIONS=true

# --- Alternative: Together (serves the same bge-base the eval used) ---
# EMBEDDING_PROVIDER=together
# EMBEDDING_API_BASE=https://api.together.xyz/v1
# EMBEDDING_API_MODEL=BAAI/bge-base-en-v1.5

# --- Google Gemini (only if your project is not blocked) ---
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_BASE=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_API_MODEL=gemini-embedding-001
# Tune upward on bigger cards. 256 fits short sentences on a ~6GB GPU but OOMs
# on 400-token chunks; 64 handles both.
EMBEDDING_BATCH_SIZE=64

# --- Uploads ----------------------------------------------------------------
# Uploaded PDFs are parked in Postgres as bytea for the web->worker handoff, so
# this cap is also a cap on how much of a 512 MB free-tier database one request
# can consume.
MAX_UPLOAD_BYTES=26214400

# --- LLM --------------------------------------------------------------------
# LLM provider: gemini | ollama | anything else = OpenAI-compatible endpoint.
# The OpenAI-compatible path needs no code changes — only these three values.
#
# --- Recommended: Groq (free tier, no card, fast) ---
LLM_PROVIDER=groq
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# --- Alternative: OpenRouter (has free models) ---
# LLM_PROVIDER=openrouter
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Google Gemini (only if your project is not blocked) ---
# LLM_PROVIDER=gemini
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-2.5-flash

# For a local Ollama model instead:
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://host.docker.internal:11434
# LLM_MODEL=qwen2.5:7b
