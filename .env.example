# Copy to .env and fill in values. Compose substitutes these into
# docker-compose.yml; the app also reads them directly via pydantic-settings.

# Database
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=tutorial_db
# When running the app OUTSIDE docker, point it at the pgbouncer port:
# DB_HOST=localhost
# DB_PORT=6432

# LLM provider: gemini | ollama | any OpenAI-compatible endpoint
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-1.5-flash

# For a local Ollama model instead:
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://host.docker.internal:11434
# LLM_MODEL=qwen2.5:7b
